# Helper image for registry-only deployments.
#
# The registry is a role of the main go-wallet-backend binary; this image is
# the same server binary with `--mode=registry` as its fixed entrypoint
# argument and a registry-only default config. It is kept, under the name
# sirosfoundation/go-wallet-registry, for a transition period so existing
# deployments keep working. New deployments can use the main image with
# `--mode=registry` (or any role combination) instead.

# Build stage
FROM golang:1.27-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

ARG VERSION=dev
ARG COMMIT=unknown

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build the main server binary (the registry role is part of it)
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o server ./cmd/server

# Data directory for the VCTM cache - copied with correct ownership
RUN mkdir -p /app/data

# Runtime stage
FROM gcr.io/distroless/static-debian12

WORKDIR /app

COPY --from=builder /app/server /app/server
COPY --from=builder /app/configs/config.registry.yaml /app/configs/config.registry.yaml

# 65532 is the nonroot user in distroless; the directory must exist with the
# right permissions before a volume is mounted over it.
COPY --from=builder --chown=65532:65532 /app/data /app/data

USER nonroot:nonroot

# Default registry port (server.registry_port)
EXPOSE 8097

# --mode=registry is part of the entrypoint so that deployments which override
# the container args (for example to point at another config file) still start
# the registry role. Extra flags are appended: `--config <backend-style file>`.
ENTRYPOINT ["/app/server", "--mode=registry"]
CMD ["--config", "/app/configs/config.registry.yaml"]
